# ==============================================================================
# M.S Solutions - Environment Configuration Template
# Fill in your Firebase project credentials from Firebase Console:
# https://console.firebase.google.com/ -> Project Settings -> General -> Your Apps
# ==============================================================================

# Firebase Web App Credentials
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Admin Dashboard Access Passcode (URL: /admin)
# You can change this to any passcode you like
VITE_ADMIN_PASSCODE=admin123

# Instant Email Notification (Optional - EmailJS)
# Get free keys from https://www.emailjs.com/ (200 free emails/month)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
VITE_ADMIN_EMAIL=official.mssolutions@gmail.com
