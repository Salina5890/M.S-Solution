rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidInquiry(data) {
      let incoming = data;
      return incoming.size() >= 7 && incoming.size() <= 13
        && incoming.fullName is string && incoming.fullName.size() >= 2 && incoming.fullName.size() <= 100
        && incoming.email is string && incoming.email.matches('^[^@]+@[^@]+\\.[^@]+$')
        && incoming.message is string && incoming.message.size() >= 10 && incoming.message.size() <= 3000
        && incoming.serviceInterest is string && incoming.serviceInterest.size() <= 100
        && incoming.status in ['new', 'contacted', 'closed']
        && incoming.source == 'web_contact_form';
    }

    // Business Inquiries Collection
    match /projectInquiries/{inquiryId} {
      allow create: if isValidInquiry(request.resource.data);
      allow read, update: if true;
      allow delete: if request.auth != null;
    }

    // Site Audience Statistics & Aggregates
    match /siteStats/{statId} {
      allow read, write: if true;
    }

    // Individual Page Visit Logs
    match /siteVisits/{visitId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // Default catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
